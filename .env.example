# Environment Variables for CRADI LMS

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/cradi_lms"
# For development, you can use SQLite: 
# DATABASE_URL="file:./dev.db"

# Authentication - CRITICAL SECURITY
# IMPORTANT: Generate strong secrets using: openssl rand -base64 32
NEXTAUTH_SECRET="your-super-secret-key-change-this-in-production"
NEXTAUTH_URL="http://localhost:3000"

# JWT Secret - MUST be minimum 32 characters random string
JWT_SECRET="your-jwt-secret-key-change-this-minimum-32-chars"

# JWT Refresh Secret - Must be DIFFERENT from JWT_SECRET
JWT_REFRESH_SECRET="your-refresh-secret-must-be-different-32-chars"

# Security
ALLOWED_ORIGINS="http://localhost:3000"
RATE_LIMIT_ENABLED="true"

# Google OAuth (Optional - for Google Sign-In)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Paystack Payment (Nigerian Market)
PAYSTACK_SECRET_KEY="your-paystack-secret-key"
PAYSTACK_PUBLIC_KEY="your-paystack-public-key"

# AWS S3 (for file uploads - optional)
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
AWS_REGION="us-east-1"
AWS_S3_BUCKET="cradi-lms-files"

# Email Service (Optional - for notifications)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
EMAIL_FROM="CRADI LMS <noreply@cradi.edu>"

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
